# ==========================================
#  Novel Agent - 环境配置
# ==========================================

# --- LLM 配置 ---
# 作者 Agent 使用的模型（推荐 DeepSeek / Qwen / Claude）
AUTHOR_MODEL_PROVIDER=deepseek          # deepseek | openai | anthropic
AUTHOR_MODEL_NAME=deepseek-chat
AUTHOR_API_KEY=your-deepseek-api-key
AUTHOR_BASE_URL=https://api.deepseek.com

# 编辑 Agent 使用的模型
EDITOR_MODEL_PROVIDER=deepseek          # deepseek | openai | anthropic  
EDITOR_MODEL_NAME=deepseek-chat
EDITOR_API_KEY=your-deepseek-api-key
EDITOR_BASE_URL=https://api.deepseek.com

# --- 备选: Anthropic Claude (需代理或 AWS Bedrock) ---
# AUTHOR_MODEL_PROVIDER=anthropic
# AUTHOR_MODEL_NAME=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=your-anthropic-key

# --- 备选: OpenAI 兼容接口 (如 Qwen via DashScope) ---
# AUTHOR_MODEL_PROVIDER=openai
# AUTHOR_MODEL_NAME=qwen-max
# AUTHOR_API_KEY=your-dashscope-key
# AUTHOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 网文抓取 ---
JINA_API_KEY=                            # 可选，Jina Reader 免费可用

# --- 通用 ---
NODE_ENV=development
LOG_LEVEL=info
